using System;

public class ContarDigitos
{
    public static void Main(string[] args)
    {
        Console.Write("Informe um número inteiro: ");
        int numero = Math.Abs(int.Parse(Console.ReadLine()));
        
        int contador = 0;

        if (numero == 0)
        {
            contador = 1;
        }
        else
        {
            while (numero > 0)
            {
                numero /= 10;
                contador++;
            }
        }
    }
}
