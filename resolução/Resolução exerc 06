import java.util.Scanner;

public class ContarDigitos {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);
        System.out.print("Informe um número inteiro: ");
        int numero = Math.abs(teclado.nextInt());
        
        int contador = 0;

        if (numero == 0) {
            contador = 1;
        } else {
            while (numero > 0) {
                numero /= 10; 
                contador++;
            }
        }
    }
}
