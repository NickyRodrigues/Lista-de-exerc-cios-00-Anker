using System;

public class Fibonacci
{
    public static void Main(string[] args)
    {
        Console.Write("Informe um número inteiro não negativo: ");
        int n = int.Parse(Console.ReadLine());

        int f0 = 0, f1 = 1;

        Console.Write("Série: ");
        for (int i = 0; i <= n; i++)
        {
            Console.Write(f0 + (i == n ? "" : ", "));
            
            // Lógica de troca para o próximo termo
            int proximo = f0 + f1;
            f0 = f1;
            f1 = proximo;
        }
    }
 }
