    private float nivelCombustivelPercentual;
    private float consumoMedio;
    private float quilometragemAtual;

    public Veiculo() {
        this.quilometragemAtual = 0;
    }

    public float calcularAutonomia() {
        float litrosNoTanque = (nivelCombustivelPercentual / 100) * capMaximaTanque;
        return litrosNoTanque * consumoMedio;
    }

    public float getQuilometragemAtual() {
        return quilometragemAtual;
