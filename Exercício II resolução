using System;

class Veiculo
{
    private int qtdOcupantes;
    private int qtdRodas;
    private float capMaximaTanque;
    private float nivelCombustivelPercentual;
    private float consumoMedio;
    private float quilometragemAtual;

    private Veiculo()
    {
        this.quilometragemAtual = 0;
    }

    private float CalcularAutonomia()
    {
        float litrosNoTanque = (nivelCombustivelPercentual / 100) * capMaximaTanque;
        return litrosNoTanque * consumoMedio;
    }

    private float GetQuilometragemAtual()
    {
        return quilometragemAtual;
    }

    private void SetQuilometragemAtual(float quilometragemAtual)
    {
        this.quilometragemAtual = quilometragemAtual;
    }

    private float GetConsumoMedio()
    {
        return consumoMedio;
    }

    private void SetConsumoMedio(float consumoMedio)
    {
        this.consumoMedio = consumoMedio;
    }
}

class Carro : Veiculo
{
    private string modelo;
    private int qtdPortas;

    private Carro() : base()
    {
    }

    private Carro(string modelo, int qtdPortas, int ocupantes, int rodas,
                 float capTanque, float nivelComb, float consumo, float km)
    {
        this.modelo = modelo;
        this.qtdPortas = qtdPortas;
        this.SetConsumoMedio(consumo);
        this.SetQuilometragemAtual(km);
    }

    private float Percorrer(float qtdQuilometros)
    {
        float novaKM = this.GetQuilometragemAtual() + qtdQuilometros;

        if (novaKM > 999999.0f)
        {
            this.SetQuilometragemAtual(999999.0f);
            Console.WriteLine("Limite do odômetro atingido!");
        }
        else
        {
            this.SetQuilometragemAtual(novaKM);
        }

        return this.GetQuilometragemAtual();
    }
}

// Q2
using System;

class CorpoCeleste
{
    private float massa;
    private float densidade;
    private float posicaoX;
    private float posicaoY;

    private CorpoCeleste(float massa, float densidade, float x, float y)
    {
        this.massa = massa;
        this.densidade = densidade;
        this.posicaoX = x;
        this.posicaoY = y;
    }

    private double CalcularRaio()
    {
        return Math.Pow((3 * massa) / (4 * Math.PI * densidade), 1.0 / 3.0);
    }

    private float GetMassa() { return massa; }
    private float GetPosicaoX() { return posicaoX; }
}

class SistemaSolar
{
    private static void Main(string[] args)
    {
        CorpoCeleste[] corpos = new CorpoCeleste[10];

        for (int i = 0; i < 10; i++)
        {
            Console.WriteLine($"Corpo {i + 1}: Massa, Densidade, X e Y:");
            float m = float.Parse(Console.ReadLine());
            float d = float.Parse(Console.ReadLine());
            float x = float.Parse(Console.ReadLine());
            float y = float.Parse(Console.ReadLine());
            corpos[i] = new CorpoCeleste(m, d, x, y);
        }

        CorpoCeleste maiorMassa = corpos[0];
        CorpoCeleste maiorRaio = corpos[0];

        foreach (CorpoCeleste c in corpos)
        {
            if (c.GetMassa() > maiorMassa.GetMassa()) maiorMassa = c;
            if (c.CalcularRaio() > maiorRaio.CalcularRaio()) maiorRaio = c;
        }

        // Encontrar os dois mais distantes no eixo X
        CorpoCeleste c1 = corpos[0], c2 = corpos[1];
        float maiorDistanciaX = Math.Abs(c1.GetPosicaoX() - c2.GetPosicaoX());

        for (int i = 0; i < corpos.Length; i++)
        {
            for (int j = i + 1; j < corpos.Length; j++)
            {
                float dist = Math.Abs(corpos[i].GetPosicaoX() - corpos[j].GetPosicaoX());
                if (dist > maiorDistanciaX)
                {
                    maiorDistanciaX = dist;
                    c1 = corpos[i];
                    c2 = corpos[j];
                }
            }
        }

        Console.WriteLine("Maior Massa: " + maiorMassa.GetMassa());
        Console.WriteLine("Maior Raio: " + maiorRaio.CalcularRaio());
        Console.WriteLine("Mais distantes em X: Pos " + c1.GetPosicaoX() + " e " + c2.GetPosicaoX());
    }
}
