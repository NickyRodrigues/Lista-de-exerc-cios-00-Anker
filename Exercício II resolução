// Exercicio 4
class Animal
{
    string _nome;
    string _tipo;

    static string ValidarTipo(string tipo)
    {
        string t = tipo.ToLower().Trim();
        if (t == "cachorro" || t == "gato" || t == "peixe")
            return char.ToUpper(t[0]) + t.Substring(1);
        return "Peixe";
    }

    internal string Nome
    {
        get => _nome;
        set => _nome = value;
    }

    internal string Tipo
    {
        get => _tipo;
        set => _tipo = ValidarTipo(value);
    }

    internal Animal()
    {
        _nome = "";
        _tipo = "Peixe";
    }
}

class NivelMedio
{
    static void Main(string[] args)
    {
        // Exercicio 1
        Console.Write("Base: ");
