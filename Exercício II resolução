// Questão 1
class Veiculo
{
    protected int quantidadeOcupantes;
    protected int quantidadeRodas;
    protected float capacidadeMaximaTanque;
    protected float nivelAtualTanquePercentual;
    protected float consumoMedio;
    protected float quilometragemAtual;
    protected float autonomia;

    public float GetQuilometragemAtual()
    {
        return quilometragemAtual;
    }

    public void SetQuilometragemAtual(float quilometragemAtual)
    {
        this.quilometragemAtual = quilometragemAtual;
    }

    public float GetConsumoMedio()
    {
        return consumoMedio;
    }

    public void SetConsumoMedio(float consumoMedio)
    {
        this.consumoMedio = consumoMedio;
    }
}

class Carro : Veiculo
{
    private string modelo;
    private int quantidadePortas;

    public Carro()
    {
    }

    public Carro(int quantidadeOcupantes, int quantidadeRodas, float capacidadeMaximaTanque,
                 float nivelAtualTanquePercentual, float consumoMedio, float quilometragemAtual,
                 float autonomia, string modelo, int quantidadePortas)
    {
        this.quantidadeOcupantes = quantidadeOcupantes;
        this.quantidadeRodas = quantidadeRodas;
        this.capacidadeMaximaTanque = capacidadeMaximaTanque;
        this.nivelAtualTanquePercentual = nivelAtualTanquePercentual;
        this.consumoMedio = consumoMedio;
        this.quilometragemAtual = quilometragemAtual;
        this.autonomia = autonomia;
        this.modelo = modelo;
        this.quantidadePortas = quantidadePortas;
    }

    public float Percorrer(float qtdQuilometros)
    {
        if (qtdQuilometros > 0)
        {
            this.quilometragemAtual += qtdQuilometros;
            if (this.quilometragemAtual > 999999f)
            {
                this.quilometragemAtual = 999999f;
            }
        }
        return this.quilometragemAtual;
    }
}

// Questão 2
using System;

class CorpoCeleste
{
    private double massa;
    private double densidade;
    private double posicaoX;
    private double posicaoY;

    public CorpoCeleste(double massa, double densidade, double posicaoX, double posicaoY)
    {
        this.massa = massa;
        this.densidade = densidade;
        this.posicaoX = posicaoX;
        this.posicaoY = posicaoY;
    }

    public double GetMassa() { return massa; }
    public double GetDensidade() { return densidade; }
    public double GetPosicaoX() { return posicaoX; }
    public double GetPosicaoY() { return posicaoY; }

    public double CalcularRaio()
    {
        double volume = this.massa / this.densidade;
        return Math.Cbrt((3 * volume) / (4 * Math.PI));
    }
}

public class Program
{
    public static void Main(string[] args)
    {
        CorpoCeleste[] corpos = new CorpoCeleste[10];

        for (int i = 0; i < 10; i++)
        {
            double m = double.Parse(Console.ReadLine());
            double d = double.Parse(Console.ReadLine());
            double x = double.Parse(Console.ReadLine());
            double y = double.Parse(Console.ReadLine());
            corpos[i] = new CorpoCeleste(m, d, x, y);
        }

        CorpoCeleste maiorMassa = corpos[0];
        CorpoCeleste maiorRaio = corpos[0];
        double maiorDistanciaX = -1;
        CorpoCeleste distante1 = null;
        CorpoCeleste distante2 = null;

        for (int i = 0; i < corpos.Length; i++)
        {
            if (corpos[i].GetMassa() > maiorMassa.GetMassa())
            {
                maiorMassa = corpos[i];
            }
            if (corpos[i].CalcularRaio() > maiorRaio.CalcularRaio())
            {
                maiorRaio = corpos[i];
            }
            for (int j = i + 1; j < corpos.Length; j++)
            {
                double distanciaX = Math.Abs(corpos[i].GetPosicaoX() - corpos[j].GetPosicaoX());
                if (distanciaX > maiorDistanciaX)
                {
                    maiorDistanciaX = distanciaX;
                    distante1 = corpos[i];
                    distante2 = corpos[j];
                }
            }
        }
    }
}
