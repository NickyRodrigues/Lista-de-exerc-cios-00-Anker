// Nivel Dificil
using System;

// Exercicio 1
class Lampada
{
    bool _ligada;

    internal bool Ligada => _ligada;

    internal void Ligar() => _ligada = true;
    internal void Desligar() => _ligada = false;

    internal void ExibirEstado() =>
        Console.WriteLine($"Lâmpada: {(_ligada ? "LIGADA" : "DESLIGADA")}");
}

class LampadaAvancada
{
    bool _ligada;
    bool _queimada;
    double _potencia;
    double _voltagem;

    static readonly Random _rng = new Random();

    internal double Potencia
    {
        get => _potencia;
        set => _potencia = value;
    }

    internal double Voltagem
    {
        get => _voltagem;
        set => _voltagem = value;
    }

    internal bool Ligada => _ligada;
    internal bool Queimada => _queimada;

    internal LampadaAvancada(double potencia, double voltagem)
    {
        _potencia = potencia;
        _voltagem = voltagem;
    }

    internal void Ligar()
    {
        if (_queimada)
        {
            Console.WriteLine("Lâmpada queimada, não pode ser ligada.");
            return;
        }
        if (_rng.NextDouble() < 0.15)
        {
            _queimada = true;
            _ligada = false;
            Console.WriteLine("A lâmpada QUEIMOU ao ser ligada!");
        }
        else
        {
            _ligada = true;
        }
    }

    internal void Desligar() => _ligada = false;

    internal void ExibirEstado()
    {
        string estado = _queimada ? "QUEIMADA" : (_ligada ? "LIGADA" : "DESLIGADA");
        Console.WriteLine($"Estado: {estado} | Potência: {_potencia}W | Voltagem: {_voltagem}V");
    }
}

// Exercicio 2
class Extrato
{
    DateTime _data;
    double _valor;

    internal Extrato(DateTime data, double valor)
    {
        _data = data;
        _valor = valor;
    }

    internal void Exibir()
    {
        string tipo = _valor >= 0 ? "Depósito" : "Saque";
        Console.WriteLine($"  [{_data:dd/MM/yyyy HH:mm}] {tipo}: R$ {Math.Abs(_valor):F2}");
    }
}

class Cartao
{
    string _numero;
    DateTime _validade;

    internal Cartao(string numero, DateTime validade)
    {
        _numero = numero;
        _validade = validade;
    }

    internal string Numero => _numero;
    internal DateTime Validade => _validade;

    internal bool EstaValido() => DateTime.Now <= _validade;
}

class Conta
{
    string _nomeCliente;
    int _numero;
    double _saldo;
    Extrato[] _extratos;
    int _totalExtratos;
    Cartao? _cartao;

    internal Conta(string nomeCliente, int numero, double saldoInicial)
    {
        _nomeCliente = nomeCliente;
        _numero = numero;
        _saldo = saldoInicial;
        _extratos = new Extrato[1000];
        _totalExtratos = 0;
    }

    internal string ObterNomeCliente() => _nomeCliente;
    internal int ObterNumero() => _numero;
    internal double ObterSaldo() => _saldo;

    internal void Depositar(double valor)
    {
        if (valor <= 0) { Console.WriteLine("Valor inválido."); return; }
        _saldo += valor;
        RegistrarExtrato(valor);
        Console.WriteLine($"Depósito de R$ {valor:F2} realizado. Saldo: R$ {_saldo:F2}");
    }

    internal void Sacar(double valor)
    {
        if (valor <= 0) { Console.WriteLine("Valor inválido."); return; }
        if (valor > _saldo) { Console.WriteLine("Saldo insuficiente."); return; }
        _saldo -= valor;
        RegistrarExtrato(-valor);
        Console.WriteLine($"Saque de R$ {valor:F2} realizado. Saldo: R$ {_saldo:F2}");
    }

    internal void SacarComCartao(double valor, string numeroCartao, DateTime validadeCartao)
    {
        if (_cartao == null)
        {
            Console.WriteLine("Esta conta não possui cartão.");
            return;
        }
        if (_cartao.Numero != numeroCartao || _cartao.Validade.Month != validadeCartao.Month
            || _cartao.Validade.Year != validadeCartao.Year)
        {
            Console.WriteLine("Cartão não reconhecido para esta conta.");
            return;
        }
        if (!_cartao.EstaValido())
        {
            Console.WriteLine("Cartão vencido.");
            return;
        }
        Sacar(valor);
    }

    internal void AssociarCartao(Cartao cartao) => _cartao = cartao;

    internal void EmitirRelatorio()
    {
        Console.WriteLine($"  Conta: {_numero} | Titular: {_nomeCliente} | Saldo: R$ {_saldo:F2}");
        Console.WriteLine("  Extrato:");
        if (_totalExtratos == 0)
        {
            Console.WriteLine("    Nenhuma movimentação.");
            return;
        }
        for (int i = 0; i < _totalExtratos; i++)
            _extratos[i].Exibir();
        if (_cartao != null)
            Console.WriteLine($"  Cartão: {_cartao.Numero} | Validade: {_cartao.Validade:MM/yyyy}");
    }

    void RegistrarExtrato(double valor)
    {
        if (_totalExtratos < 1000)
            _extratos[_totalExtratos++] = new Extrato(DateTime.Now, valor);
    }
}

