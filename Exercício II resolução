using System;

// Exercicio 1
class Retangulo
{
    double _base;
    double _altura;

    internal Retangulo(double b, double h)
    {
        _base = b;
        _altura = h;
    }

    internal double Area => _base * _altura;

    internal void ExibirDados()
    {
        Console.WriteLine($"Base: {_base}");
