            teste.Ligar();
            string res = teste.Queimada ? "queimou" : "funcionou";
            Console.WriteLine($"Tentativa {i + 1}: {res}");
        }

        // Exercicio 2
        Conta c1 = new Conta("Alice Silva", 1001, 500.00);
        Conta c2 = new Conta("Bruno Costa", 1002, 1200.00);
        Conta c3 = new Conta("Carla Mendes", 1003, 300.00);

        c1.AssociarCartao(new Cartao("1111-2222-3333-4444", new DateTime(2027, 12, 31)));
        c2.AssociarCartao(new Cartao("5555-6666-7777-8888", new DateTime(2026, 6, 30)));
        c3.AssociarCartao(new Cartao("9999-0000-1111-2222", new DateTime(2025, 1, 1)));

        c1.Depositar(300.00);
        c1.Sacar(100.00);
        c1.SacarComCartao(50.00, "1111-2222-3333-4444", new DateTime(2027, 12, 31));

        c2.Depositar(800.00);
        c2.Sacar(500.00);
        c2.SacarComCartao(200.00, "5555-6666-7777-8888", new DateTime(2026, 6, 30));

        c3.Depositar(150.00);
        c3.SacarComCartao(50.00, "9999-0000-1111-2222", new DateTime(2025, 1, 1));

        foreach (Conta c in new[] { c1, c2, c3 })
        {
            Console.WriteLine("---------------------------");
            c.EmitirRelatorio();
        }
    }
}
